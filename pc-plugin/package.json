{
  "name": "@local/dsh-mobile-bridge",
  "version": "0.1.1",
  "private": true,
  "description": "把 PC 上的 DSH 通过 Tailscale 安全地借给手机：配对、反向代理、任务推送。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib",
    "locale",
    "scripts",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/core.test.js test/store.test.js test/proxy.test.js test/integration.test.js"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
